# Copy this file to .env and fill ONLY the provider(s) you plan to use.
# Never commit .env or paste real keys into source code / shell history.

# OpenAI models (gpt-*), and GPT-based GT text generation during evaluation.
OPENAI_API_KEY=""
# Leave empty for the official OpenAI endpoint. For an OpenAI-compatible proxy,
# set the full API root, usually ending in /v1.
OPENAI_BASE_URL=""

# Anthropic models (claude-*).
ANTHROPIC_API_KEY=""

# Google Gemini models used for main prediction.
GEMINI_API_KEY=""
GEMINI_API_BASE="https://generativelanguage.googleapis.com"
# Use "google" for the official v1beta API or "openai" for a third-party
# OpenAI-compatible /v1 endpoint.
GEMINI_API_MODE="google"
# Optional main-prediction model override. Third-party services may require
# provider-specific prefixes, for example "[L]gemini-3.1-pro-preview".
GEMINI_MODEL=""
# Optional legacy/fallback evaluation model override.
GEMINI_MODEL_ID="gemini-2.5-pro"

# Gemini video evaluation. These settings are separate because a proxy may
# expose main prediction through an OpenAI-compatible /v1 endpoint, but expose
# video input through a Gemini-native endpoint such as /gemini.
# If empty, GEMINI_API_KEY is used.
GEMINI_EVAL_API_KEY=""
# Leave empty for Google's official endpoint. AiHubMix example:
# https://aihubmix.com/gemini
GEMINI_EVAL_API_BASE=""
GEMINI_EVAL_MODEL="gemini-2.5-pro"
GEMINI_EVAL_MAX_RETRIES="3"
GEMINI_EVAL_RETRY_BACKOFF_SECONDS="5"

# Alibaba Cloud Model Studio / DashScope models (qwen-*).
DASHSCOPE_API_KEY=""
# The key and endpoint MUST be from the same region. Choose exactly one:
# Beijing:  https://dashscope.aliyuncs.com/compatible-mode/v1
# Singapore:https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Virginia: https://dashscope-us.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_BASE="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# K12Vista full-dataset screening. Keep these empty unless running screening.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_TEXT_MODEL=""
QWEN_VL_MODEL=""
# Optional alias accepted by the screening pipeline; DASHSCOPE_API_BASE above
# is preferred for consistency with the generation client.
DASHSCOPE_BASE_URL=""

# Hugging Face Inference Providers (hf:* models).
HF_TOKEN=""
HF_API_BASE="https://router.huggingface.co/v1"
# Optional: override the model ID mapped by src/physics_prediction.py.
HF_MODEL=""

# Optional generation controls.
LLM_MAX_COMPLETION_TOKENS="16384"
GEMINI_MAX_RETRIES="6"

# Optional tracing. These are not model API keys and may stay empty.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=""
